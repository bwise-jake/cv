{
  "name": "jaketb-cv",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pdf": "vite build && tsx scripts/export-pdfs.ts",
    "og": "vite build && tsx scripts/og-image.ts",
    "check:contrast": "vite build && tsx scripts/check-contrast.ts",
    "lint": "npm run lint:css && npm run lint:ts",
    "lint:css": "stylelint src/styles/atlassian.css",
    "lint:ts": "eslint src scripts tests",
    "ads:tokens": "tsx scripts/generate-ads-tokens.ts"
  },
  "devDependencies": {
    "@atlaskit/eslint-plugin-design-system": "^16.14.0",
    "@atlaskit/stylelint-design-system": "^5.1.4",
    "@atlaskit/tokens": "^20.8.2",
    "@babel/core": "^8.0.9",
    "@babel/eslint-parser": "^8.0.7",
    "@babel/preset-typescript": "^8.0.7",
    "@types/node": "^26.6.2",
    "eslint": "^10.13.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "playwright": "^1.63.0",
    "stylelint": "^17.16.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
